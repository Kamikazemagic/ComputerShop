<Page x:Class="ComputerShop.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComputerShop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bal oldal -->
        <Border Grid.Column="0" Background="LightGray">
            <TextBlock x:Name="LargeWindow"
                       Text="Üdv a rendszerben!"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold"/>
        </Border>

        <!-- Jobb oldal -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Fejléc -->
                <RowDefinition Height="*"/>
                <!-- Login űrlap -->
                <RowDefinition Height="Auto"/>
                <!-- Gombok -->
            </Grid.RowDefinitions>

            <!-- Fejléc -->
            <TextBlock Grid.Row="0"
                       Text="Jelentkezz be!"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Bejelentkező űrlap -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Felhasználónév -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Felhasználónév:" Margin="0,0,5,10" VerticalAlignment="Center"/>
                <TextBox x:Name="userNameTextBox" Grid.Row="0" Grid.Column="1" Width="150" Margin="0,0,0,10" HorizontalAlignment="Left"/>

                <!-- Jelszó -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Jelszó:" Margin="0,0,5,10" VerticalAlignment="Center"/>
                <PasswordBox x:Name="userPasswordTextBox" Grid.Row="1" Grid.Column="1" Width="150" Margin="0,0,0,10" HorizontalAlignment="Left"/>
            </Grid>

            <!-- Gombok -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                <Button Content="Bejelentkezés"
                        Width="100"
                        Click="Button_Click"/>
                <Button Content="Regisztráció"
                        Width="100"
                        Foreground="Blue"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Button_Click_1"/>
            </StackPanel>

        </Grid>
    </Grid>
</Page>
